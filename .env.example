# Copy to .env for local development. On Render, set these in dashboard env vars.

# REQUIRED — Anthropic API key for the Claude Agent SDK
ANTHROPIC_API_KEY=sk-ant-...

# REQUIRED — shared password for accessing the app
APP_PASSWORD=change-me-to-something-strong

# REQUIRED — secret key for signing auth cookies
# Generate with: openssl rand -hex 32
APP_SECRET_KEY=replace-with-random-32-byte-hex

# OPTIONAL — which skill to invoke. Defaults to "example-stock-chart" (the placeholder).
# Change to your private skill name after you've added one to .claude/skills/
SKILL_NAME=example-stock-chart

# OPTIONAL — fetch a private skills bundle at startup (see scripts/fetch_skills.py).
# Useful when deploying a public repo with private skills kept elsewhere.
# Examples:
#   https://example.com/my-skills.tar.gz       (signed URL, recommended)
#   https://github.com/you/private-skills/...  (private repo, needs SKILLS_BUNDLE_TOKEN)
# SKILLS_BUNDLE_URL=
# SKILLS_BUNDLE_TOKEN=

# OPTIONAL — rate limits (slowapi format)
RATE_LIMIT_GENERATE=10/day
RATE_LIMIT_RESOLVE=30/minute

# OPTIONAL — used by Render. Leave unset locally.
PORT=8000
